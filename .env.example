# --- Server ---
PORT=3010
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Request body limit, bytes. Bulk indexing requests must fit: MAX_BATCH documents of up to MAX_DOC_BYTES each.
BODY_LIMIT=8388608

# --- Storage ---
DB_PATH=./data/search.db

# --- Callers: id:secret[:role[:indexes]], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: write (create indexes, index and delete documents), read (search, suggest, browse, stats), readwrite (default).
# indexes: names the key may touch, joined with "+"; omitted = all. A scoped key cannot see or create other indexes.
SEARCH_API_KEYS=console:REPLACE_WITH_64_HEX_CHARS,shop-backend:REPLACE_WITH_64_HEX_CHARS:write:products,shop-web:REPLACE_WITH_64_HEX_CHARS:read:products
# Requests per key per minute.
RATE_LIMIT_MAX=1200

# --- Limits ---
# Documents per indexing request; largest JSON-encoded document; attribute values per document.
MAX_BATCH=500
MAX_DOC_BYTES=65536
MAX_ATTRS=50
# Largest page and deepest offset a search may ask for; values returned per facet.
MAX_PAGE=100
MAX_OFFSET=10000
MAX_FACET_VALUES=20
